{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  }
}
