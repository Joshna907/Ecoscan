# Copy to .env.production. Generate a different random value for each secret.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
RATE_LIMIT_HASH_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=

# Use openai for real image recognition. Mock mode is only a backend smoke demo.
VISION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

# The API is bound to loopback; put a TLS reverse proxy in front of it.
API_PORT=5000
# Set to 1 only when one trusted reverse proxy is the sole public entry point.
TRUST_PROXY_HOPS=0
