# Copy this file to backend/.env, then add your key locally. Never commit backend/.env.
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

# For persistent sessions and rewards, run PostgreSQL and apply the migration.
# The default memory mode is only for local demos and tests.
DATA_STORE=postgres
DATABASE_URL=postgresql://ecoscan:ecoscan@localhost:5433/ecoscan
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# Optional reliability settings (all values are positive integers).
SESSION_TTL_MS=1800000
ANALYSIS_TTL_MS=900000
RESULT_RETENTION_MS=3600000
CLEANUP_INTERVAL_MS=60000
MAX_SESSIONS=1000
MAX_ANALYSES_PER_SESSION=50
# Each IP starts with 5 tokens; one token refills every 12 seconds.
SCAN_RATE_CAPACITY=5
SCAN_RATE_REFILL_MS=12000
MAX_RATE_CLIENTS=5000
# Includes uploads being read and recognition requests in progress.
MAX_CONCURRENT_SCANS=5
# Maximum waiting or processing photos held in PostgreSQL.
MAX_QUEUED_JOBS=100
# Use the same long random value on every API instance; never commit a real value.
RATE_LIMIT_HASH_KEY=
MAX_CONCURRENT_VISION=3
MAX_DAILY_VISION_CALLS=500

# Required on Vercel: random secret, at least 32 characters; never commit its value.
CRON_SECRET=

# Optional: trusted partner API credential, never sent to the browser.
PARTNER_API_SECRET=
# Optional: absolute path to a reviewed/licensed material factor snapshot.
MATERIAL_FACTORS_FILE=
# Optional independent activity verification. Keep these server-side only.
# ACTIVITY_EVIDENCE_HASH_KEY=<stable random secret, at least 32 characters>
# ACTIVITY_EVIDENCE_PARTNERS=[{"id":"approved-repair-shop","name":"Approved Repair Shop","secret":"<random partner signing secret, at least 32 characters>","activities":["repair"]}]
# Optional restricted operator API (not an end-user account/login).
# REWARD_REVIEW_OPERATORS=[{"id":"reviewer-one","token":"<random server-side token, at least 32 characters>"}]
